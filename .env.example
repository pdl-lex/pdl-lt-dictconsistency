# Zugang zur wbdb-Datenbank (Repo pdl-lt-wbdb, siehe setup/Readme Access WBDB.md).
# Nach .env kopieren und mit echten Werten füllen; .env ist gitignored.

POSTGRES_HOST=127.0.0.1
# "localhost" statt der IP führt unter Windows oft zu ~2 Minuten Verbindungsaufbau
# (IPv6-Versuch läuft erst in ein Timeout, bevor IPv4 versucht wird).
POSTGRES_PORT=5433
POSTGRES_DB=wbdb

# Rolle wbdb_dictconsistency — rein lesend, existiert bereits in wbdb.
WBDB_READER_USER=wbdb_dictconsistency
WBDB_READER_PASSWORD=

# Vorgabe-Principal für Anfragen ohne angemeldeten Nutzer (Batch, Phase-1-Übergangszustand).
WBDB_PRINCIPAL=anon

# Lokale SQLite-Datenbank für Accounts/Sessions (Nutzerverwaltung, unabhängig von wbdb).
LT_LOCAL_DB_PATH=./local.db
